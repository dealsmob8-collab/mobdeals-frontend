# Copy this file to `.env.local` and replace the placeholder values.

# Required for webhook verification and webhook route testing.
WC_WEBHOOK_SECRET=whsec_your_woocommerce_webhook_secret

# Optional runtime overrides.
# Leave these as-is unless your origin or public URLs differ.
WP_BASE_URL=https://origin.mobdeals.co.ke
WP_JSON_BASE=https://origin.mobdeals.co.ke/wp-json
SITE_URL=https://mobdeals.co.ke
ALT_SITE_URL=https://shop.mobdeals.co.ke

# Optional deployment auth if you want to deploy from this machine with env vars
# instead of relying on an existing Wrangler login.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Notes:
# - The current app code reads the WooCommerce and URL vars above.
# - Cloudflare KV namespace IDs are not read from `.env` in this repo.
#   If they need to change, update `wrangler.toml` directly:
#   - WEBHOOK_REPLAY_KV
#   - MOBDEALS_CART_KV
#   - NEXT_CACHE_WORKERS_KV
